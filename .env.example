# Database (Neon Serverless Postgres with ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-sparkling-cherry-93081568.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
PORT=5000

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=iryvrkf0
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@iryvrkf0

# Google Maps API (Optional, interactive mock radar fallback is enabled when empty)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Payment Gateway (Mock payment enabled by default for seamless local/dev testing)
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_SECRET_KEY=your_stripe_secret_key
